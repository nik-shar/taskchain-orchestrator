# ---------------------------------------------------------------------------
# LLM provider — any OpenAI-compatible endpoint works
# ---------------------------------------------------------------------------
# Pick a preset with LLM_PROVIDER: openai | nebius | deepseek | ollama
# Presets fill in the endpoint and a sensible default model; LLM_BASE_URL,
# LLM_MODEL and LLM_API_KEY override them when set.
LLM_PROVIDER=openai
LLM_API_KEY=sk-your_api_key_here
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1

# Provider examples (uncomment the block you need):
#
# Nebius
#   LLM_PROVIDER=nebius
#   LLM_API_KEY=<nebius-api-key>
#
# DeepSeek
#   LLM_PROVIDER=deepseek
#   LLM_API_KEY=<deepseek-api-key>
#
# Local Ollama (no API key needed)
#   LLM_PROVIDER=ollama
#   LLM_MODEL=llama3.1
#
# OPENAI_API_KEY is still accepted as an alias for LLM_API_KEY.

# GitHub personal access token (required for issue/PR ingestion and opening PRs)
GITHUB_TOKEN=ghp-your_github_token_here

# SQLite database URL for the local RAG index.
# Must stay SQLite: the keyword index uses FTS5, which Postgres does not provide.
DATABASE_URL=sqlite:///data/rag_index.sqlite

# ---------------------------------------------------------------------------
# Sandboxed execution — optional overrides
# ---------------------------------------------------------------------------
# `sandbox_run` executes agent-authored commands in this image with
# --network none, a non-root user and resource caps.
# DOCKER_SANDBOX_IMAGE=python:3.11-slim
# SANDBOX_TIMEOUT_S=300
# SANDBOX_MEMORY=1g
# SANDBOX_CPUS=2
# SANDBOX_PIDS_LIMIT=256
# Test command to suggest to the agent; otherwise inferred from the repo manifests.
# SANDBOX_TEST_COMMAND=python -m pytest -q

# Escape hatches. DEVELOPMENT ONLY — see docs/decisions.md §5.
# Allows sandbox_run to reach the network (needed for `pip install` inside a run).
# SANDBOX_ALLOW_NETWORK=True
# Runs commands directly on the host when Docker is unavailable. The default is to
# refuse, because the commands are agent-authored.
# SANDBOX_ALLOW_HOST_FALLBACK=True
