# LLM provider
NEBIUS_API_KEY=your_nebius_api_key_here

# Optional overrides for the LLM endpoint/model
LLM_BASE_URL=https://api.tokenfactory.uk-south1.nebius.com/v1/
LLM_MODEL=deepseek-ai/DeepSeek-V4-Pro

# Optional overrides for embeddings
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
NEBIUS_EMBEDDING_API_KEY=
NEBIUS_EMBEDDING_BASE_URL=

# MCP server
TASKCHAIN_MCP_HOST=127.0.0.1
TASKCHAIN_MCP_PORT=9019

# Optional: disable semantic retrieval and use keyword-only retrieval
TASKCHAIN_DISABLE_SEMANTIC_RETRIEVAL=0
