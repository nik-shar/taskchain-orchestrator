# LLM Provider Configuration (Supports OpenAI, Nebius, DeepSeek, Ollama, etc.)
# Any OpenAI-compatible provider can be used by configuring the endpoints below.

# General LLM API Key (e.g. OpenAI key, Nebius API key, DeepSeek key, etc.)
NEBIUS_API_KEY=your_api_key_here

# Chat Model Settings
LLM_BASE_URL=https://api.tokenfactory.nebius.com/v1/
LLM_MODEL=PrimeIntellect/INTELLECT-3

# Embeddings Model Settings
NEBIUS_EMBEDDING_BASE_URL=https://api.tokenfactory.uk-south1.nebius.com/v1/
NEBIUS_EMBEDDING_API_KEY=your_api_key_here
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B

# GitHub Access Token (required for fetching repo data)
GITHUB_TOKEN=your_github_personal_access_token_here

# Database URL Connection String
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/taskchain
